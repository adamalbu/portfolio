---
const { status, class: extraClasses } = Astro.props;

let style = "red-500";

switch (status) {
    case "Pre-alpha":
        style = "bg-primary/50 border-primary/70";
        break;
    case "Alpha":
        style = "bg-secondary/50 border-secondary/70";
        break;
    case "Beta":
        style = "bg-accent/50 border-accent/70";
        break;
    case "Release":
        style = "bg-lime-500/50 border-lime-500/70";
        break;
    default:
        style = "bg-red-500/50 border-red-500";
}
---

<p
    class={`border ${style} text-sm font-semibold rounded-lg px-2 py-1 md:mt-0 w-fit h-fit ${extraClasses}`}
>
    {status}
</p>
