---
const { title, link, description, status } = Astro.props;

let color = "red-500"; // Default color

switch (status) {
    case "Pre-alpha":
        color = "bg-primary/50";
        break;
    case "Alpha":
        color = "bg-secondary/50";
        break;
    case "Beta":
        color = "bg-accent/50";
        break;
    case "Release":
        color = "bg-lime-500/50";
        break;
    default:
        color = "bg-red-500/50";
}
---

<a
    class="bg-primary/10 p-7 lg:p-8 xl:p-10 rounded-2xl transition-transform hover:scale-101 motion-reduce:hover:transform-none"
    href={link}
>
    <div class="md:flex md:justify-between md:items-center">
        <h1 class="font-bold text-xl">{title}</h1>
        <p
            class={`${color} text-sm font-semibold rounded-lg px-2 py-1 mt-2 md:mt-0 w-fit`}
        >
            {status}
        </p>
    </div>
    <p class="mt-4">{description}</p>
</a>
