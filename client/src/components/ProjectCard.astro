---
import ProjectChip from "./ProjectChip.astro";
const { title, link, description, status } = Astro.props;
---

<a
    class="bg-primary/10 p-7 lg:p-8 xl:p-10 rounded-2xl motion-safe:transition-all hover:scale-101 motion-reduce:hover:transform-none
    outline-1 outline-primary/30 hover:outline-2 focus:outline-2 hover:outline-offset-3 focus:outline-offset-3"
    href={link}
>
    <div class="md:flex md:justify-between md:items-center">
        <h1 class="font-bold text-xl">{title}</h1>
        <ProjectChip status={status} />
    </div>
    <p class="mt-4">{description}</p>
</a>
