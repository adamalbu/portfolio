---
import Layout from "../../layouts/Layout.astro";
import ProjectChip from "../../components/ProjectChip.astro";

import {readFile} from "node:fs/promises";
import { getCollection } from "astro:content";

const wordCount = 15;

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { projectId: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;

// import * as module from "../../../src/content/fmm/extra.md";

let Extra = null
try {
const module = await import(`../../../src/content/${project.data.id}/extra.md`);
Extra = module.Content;
} catch {}

const devlogs = await getCollection(
    "devlogs",
    (devlog) => devlog.data.project === project.id,
);
---

<Layout>
    <style>
        @import "tailwindcss";
        .md-content :global(a) {
            color: var(--color-primary);
        }

        .md-content :global(a:hover) {
            text-decoration: underline;
            text-decoration-style: wavy;
            text-decoration-thickness: 1px;
        }

        .md-content :global(ul) {
            list-style-position: inside;
        }

        .md-content :global(li::before) {
            content: "- ";
            margin-left: 4px;
        }

        .md-content :global(p) {
            @apply mb-4;
        }
    </style>
    <div class="flex items-end space-x-5">
        <h1>{project.data.name}</h1>
        <ProjectChip status={project.data.status} />
    </div>
    <p class="text-text/80">{project.data.description}</p>
    <hr />
    {project.data.source && <p>Source: <a href={project.data.source} class="link text-accent">{project.data.source}</a></p>}
    { Extra != null && <div class="md-content"><Extra /></div> }
    { devlogs.length != 0 &&
    <h2>Devlogs</h2>
    <ul class="px-5 text-text">
        <hr class="mt-3" />
        {
            devlogs.map((devlog) => {
                const formattedDate = devlog.data.date.toLocaleDateString(
                    "en-US",
                    {
                        month: "2-digit",
                        day: "2-digit",
                        year: "numeric",
                    },
                );

                const words = devlog.body?.replace(/^#.*$/gm, '').trim().split(/\s+/);
                const firstWords = words?.slice(0, wordCount).join(' ') + ((words?.length ?? 0) > wordCount ? '...' : '');

                return (
                    <li class="py-2 px-4">
                        <a href={`/project/${devlog.id}`} class="subtle-link">
                            {devlog.data.title}
                        </a>
                        <span class="opacity-70 before:content-['•'] ml-0.5">
                            {formattedDate}
                        </span>
                        <p class="text-text/70">
                            {firstWords}
                        </p>
                    </li>
                    <hr class="mt-2" />
                );
            })
        }
    </ul>
    }
</Layout>
